{% extends 'base.html.twig' %}

{% block title %}Drenaje index{% endblock %}

{% block body %}
    <h1>Drenaje index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Descripcion</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for drenaje in drenajes %}
            <tr>
                <td>{{ drenaje.id }}</td>
                <td>{{ drenaje.descripcion }}</td>
                <td>
                    <a href="{{ path('app_drenaje_show', {'id': drenaje.id}) }}">show</a>
                    <a href="{{ path('app_drenaje_edit', {'id': drenaje.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_drenaje_new') }}">Create new</a>
{% endblock %}
