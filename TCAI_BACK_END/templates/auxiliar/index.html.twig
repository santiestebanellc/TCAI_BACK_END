{% extends 'base.html.twig' %}

{% block title %}Auxiliar index{% endblock %}

{% block body %}
    <h1>Auxiliar index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Num_trabajador</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for auxiliar in auxiliars %}
            <tr>
                <td>{{ auxiliar.id }}</td>
                <td>{{ auxiliar.numTrabajador }}</td>
                <td>{{ auxiliar.nombre }}</td>
                <td>{{ auxiliar.apellidos }}</td>
                <td>
                    <a href="{{ path('app_auxiliar_show', {'id': auxiliar.id}) }}">show</a>
                    <a href="{{ path('app_auxiliar_edit', {'id': auxiliar.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_auxiliar_new') }}">Create new</a>
{% endblock %}
