{% extends 'base.html.twig' %}

{% block title %}Higiene index{% endblock %}

{% block body %}
    <h1>Higiene index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Descripcion</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for higiene in higienes %}
            <tr>
                <td>{{ higiene.id }}</td>
                <td>{{ higiene.descripcion }}</td>
                <td>
                    <a href="{{ path('app_higiene_show', {'id': higiene.id}) }}">show</a>
                    <a href="{{ path('app_higiene_edit', {'id': higiene.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_higiene_new') }}">Create new</a>
{% endblock %}
