{% extends 'base.html.twig' %}

{% block title %}TipoDrenaje index{% endblock %}

{% block body %}
    <h1>TipoDrenaje index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Descripcion</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for tipo_drenaje in tipo_drenajes %}
            <tr>
                <td>{{ tipo_drenaje.id }}</td>
                <td>{{ tipo_drenaje.descripcion }}</td>
                <td>
                    <a href="{{ path('app_tipo_drenaje_show', {'id': tipo_drenaje.id}) }}">show</a>
                    <a href="{{ path('app_tipo_drenaje_edit', {'id': tipo_drenaje.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_tipo_drenaje_new') }}">Create new</a>
{% endblock %}
